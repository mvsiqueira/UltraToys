<Window x:Class="UltraToys.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UltraToys"
        Width="700" Height="560"
        MinWidth="480" MinHeight="360"
        Background="{DynamicResource BgDeep}"
        Icon="/Resources/app-icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Ícone UltraToys: glifo dourado -->
                <Viewbox Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="48" Height="48">
                        <Path Data="M 8.5,14 A 5.5,5.5 0 1 0 19.5,14 A 5.5,5.5 0 1 0 8.5,14 Z
                                    M 28.5,14 A 5.5,5.5 0 1 0 39.5,14 A 5.5,5.5 0 1 0 28.5,14 Z
                                    M 11,26 A 13,13 0 1 0 37,26 A 13,13 0 1 0 11,26 Z
                                    M 11.6,14 A 2.4,2.4 0 1 0 16.4,14 A 2.4,2.4 0 1 0 11.6,14 Z
                                    M 31.6,14 A 2.4,2.4 0 1 0 36.4,14 A 2.4,2.4 0 1 0 31.6,14 Z
                                    M 17.1,24 A 1.9,1.9 0 1 0 20.9,24 A 1.9,1.9 0 1 0 17.1,24 Z
                                    M 27.1,24 A 1.9,1.9 0 1 0 30.9,24 A 1.9,1.9 0 1 0 27.1,24 Z
                                    M 21.4,30 A 2.6,2.6 0 1 0 26.6,30 A 2.6,2.6 0 1 0 21.4,30 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                                    <GradientStop Offset="0" Color="#E7BE55" />
                                    <GradientStop Offset="1" Color="#C4892C" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Canvas>
                </Viewbox>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UltraToys" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource HeaderFg}" />
                    <TextBlock Text="Caixa de ferramentas para Windows" FontSize="11"
                               Foreground="{DynamicResource HeaderFg}" Opacity="0.55" />
                </StackPanel>

            </StackPanel>
        </Border>

    <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Sempre no topo -->
            <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AlwaysOnTop.IsEnabled}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Sempre no topo" FontSize="15" FontWeight="Bold" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="Atalho: " /><Run Text="{Binding AlwaysOnTop.HotkeyDisplay, Mode=OneWay}" />
                    </TextBlock>

                    <CheckBox Content="Mostrar borda ao redor de janelas fixadas"
                              IsChecked="{Binding AlwaysOnTop.ShowBorderOverlay}" Margin="0,0,0,10" />

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Atualizar lista" Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding AlwaysOnTop.RefreshWindowsCommand}" />
                        <TextBlock Text="Janelas abertas" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding AlwaysOnTop.Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgRow}" CornerRadius="4"
                                        Padding="10,6" Margin="0,0,0,4">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsPinned}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mover apps para Monitor -->
            <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding MoveToMonitor.IsEnabled}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Mover apps para Monitor" FontSize="15" FontWeight="Bold" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource TextSecondary}"
                               Text="Move todas as janelas abertas para o monitor escolhido." />

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Atualizar monitores" Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding MoveToMonitor.RefreshMonitorsCommand}" />
                        <TextBlock Text="Monitores detectados" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding MoveToMonitor.Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.MoveToMonitor.MoveAllWindowsToMonitorCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="Monitor" /><Run Text=" " /><Run Text="{Binding Index, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10">
                                            <Run Text="{Binding Bounds.Width, Mode=OneWay, StringFormat={}{0:0}}" />
                                            <Run Text="x" />
                                            <Run Text="{Binding Bounds.Height, Mode=OneWay, StringFormat={}{0:0}}" />
                                        </TextBlock>
                                        <TextBlock Text="Principal" FontSize="10" FontStyle="Italic"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Rodapé -->
            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
