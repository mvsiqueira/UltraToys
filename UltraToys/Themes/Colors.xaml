<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fundos -->
    <SolidColorBrush x:Key="BgDeep" Color="#FF141414" />
    <SolidColorBrush x:Key="BgPanel" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="BgRow" Color="#FF242424" />
    <SolidColorBrush x:Key="BgRowHover" Color="#FF2C2C2C" />

    <!-- Cabeçalho -->
    <SolidColorBrush x:Key="BgHeader" Color="#FF191919" />
    <SolidColorBrush x:Key="HeaderFg" Color="#FFEDEDED" />

    <!-- Textos -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF6E6E6E" />

    <!-- Bordas -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#FF333333" />

    <!-- Acento (dourado, alinhado ao ícone) -->
    <SolidColorBrush x:Key="Accent" Color="#FFC9A24B" />
    <SolidColorBrush x:Key="Danger" Color="#FFD16B6B" />

</ResourceDictionary>
